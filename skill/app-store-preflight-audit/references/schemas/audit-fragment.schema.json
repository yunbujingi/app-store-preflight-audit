{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/app-store-preflight/audit-fragment.schema.json",
  "title": "App Store preflight audit fragment",
  "type": "object",
  "required": ["schema_version", "tool", "generated_at", "layer", "subject", "checks", "findings", "data"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "tool": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "layer": {"$ref": "#/$defs/layer"},
    "subject": {
      "type": "object",
      "required": ["name", "path_fingerprint", "revision"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "path_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "revision": {"type": ["string", "null"]}
      }
    },
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "data": {"type": "object"}
  },
  "$defs": {
    "layer": {"enum": ["source", "policy", "build", "unit_test", "ui_test", "archive", "runtime", "app_store_connect"]},
    "disposition": {"enum": ["PASS", "FAIL", "N/A", "NOT_RUN", "NEEDS_VERIFY", "BLOCKED"]},
    "verification": {"enum": ["CONFIRMED", "INFERRED", "UNRESOLVED"]},
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "path": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "detail": {"type": "string"},
        "pattern": {"type": "string"}
      },
      "additionalProperties": true
    },
    "check": {
      "type": "object",
      "required": ["id", "layer", "disposition", "verification", "summary", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "layer": {"$ref": "#/$defs/layer"},
        "disposition": {"$ref": "#/$defs/disposition"},
        "verification": {"$ref": "#/$defs/verification"},
        "summary": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "blocker": {"type": "string"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "disposition", "verification", "category", "title", "explanation", "authority", "evidence", "remediation", "assumptions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "disposition": {"$ref": "#/$defs/disposition"},
        "verification": {"$ref": "#/$defs/verification"},
        "category": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1},
        "authority": {
          "type": "object",
          "required": ["type", "url"],
          "properties": {
            "type": {"enum": ["APP_REVIEW_GUIDELINE", "APP_STORE_CONNECT_REQUIREMENT", "PRIVACY_REQUIREMENT", "HIG", "PLATFORM_TECHNICAL_REQUIREMENT", "QUALITY_ONLY"]},
            "url": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        },
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "remediation": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
